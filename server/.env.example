# Copy to .env (dev) or /etc/green-guardians/api.env (prod). Never commit real values.
PORT=5200
# Optional custom Python executable for server receipt OCR; default: .venv-ocr/bin/python.
# GG_OCR_PYTHON=/opt/green-guardians/server/.venv-ocr/bin/python
# 127.0.0.1 = only nginx can reach it. Use 0.0.0.0 to expose 5200 directly (not recommended).
HOST=127.0.0.1
DB_PATH=./data/green-guardians.db
# >= 32 random chars: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# true = server accepts "demo" proofs (hackathon jury demo). Keep false in production.
DEMO_MODE=false

# Kilo AI gateway (OpenAI-compatible) for Guardian AI chat. Free models need NO key.
KILO_ENABLED=true
# Optional: only for higher limits / paid models.
KILO_API_KEY=
KILO_BASE_URL=https://api.kilo.ai/api/gateway
# Keep kilo-auto/free (owner requirement). Optional comma list = fallbacks in order.
KILO_MODEL=kilo-auto/free
KILO_FIRST_EVENT_MS=90000
KILO_FIRST_TEXT_MS=90000

# Tranzy OpenData (CTP Iasi live vehicles). Key: https://apps.tranzy.ai/accounts
TRANZY_API_KEY=
# Optional: auto-detected from /agency by name ("Iasi") when empty.
TRANZY_AGENCY_ID=
# Max distance (m) between user and a vehicle of the chosen route when boarding/alighting.
BOARD_RADIUS_M=300

# Community boss counts trips from this day on.
BOSS_START=2026-10-01
